# Per-machine git config file.
# Machines may use most of shared configs and a few to customze.
# For example, a machine may be used mainly for personal repos and sometimes for work; another may be opposite.

[core]
	# editor = code --wait

	# autocrlf = true # for Windows
	autocrlf = input # for Linux

[user]
	name = Leyvi Ni
	# email = TODO

[credential]
	# used to store multiple tokens
	# https://git-scm.com/docs/gitcredentials#Documentation/gitcredentials.txt-useHttpPath
	#useHttpPath = true

	# TODO: This is from Git for Windows system config.
	#       What are possible values?
	#       Does this work also for MSYS2?
	#helper = manager
	# for MSYS2, requires package git-credential-wincred (of proper environment like UCRT64)
	#helper = wincred
	# for Linux, seems there's no safe way to store credentials, but plaintext only (in ~/.git-credentials).
	#helper = store

# Conditionally include another config file to overwrite some settings.
# The following is used on machine that's mainly for work
# but sometimes used for personal repositories.
[includeIf "hasconfig:remote.*.url:git@github.com:llskyhi/*"]
	# Using SSH key pairs to access GitHub repositories always uses credential git@github.com,
	# which means exactly one SSH key would be active when multiple are used (each added in an account)
	# for loggin in as user "git", in default configuration, it results in that another key never seems to work.
	# A work around to this is using core.sshCommand config with like 'ssh -i ~./id_ed25519-GitHub-llskyhi.pub'.
	path = ~/.config/git/github-llskyhi.gitconfig
