# Global-scope git config file, usually locates at ~/.gitconfig.
# Can be edited by: git config --edit --global
[credential]
	# used to store multiple tokens
	# https://git-scm.com/docs/gitcredentials#Documentation/gitcredentials.txt-useHttpPath
	useHttpPath = true

[rebase]
	autoSquash = true

[alias]
	aliases = config --get-regexp ^alias\\.

	confige = config --edit
	configs = config --list

	commit-init = commit --allow-empty
	commitv = commit --verbose
	commita = commitv --amend
	commitan = commit --amend --no-edit
	commitf = commit --fixup

	rebasei = rebase --interactive --autostash --autosquash

	fetchp = fetch --prune
	f = fetchp

	stashu = stash --include-untracked

	tags = tag --list

	# https://stackoverflow.com/a/35075021
	adog = log --all --decorate --oneline --graph

	logg = log --all --decorate=short --graph --pretty=tformat:'\t''%C(yellow)%h%C(reset) %C(green)%ci%C(reset) %C(ul)%an%C(reset)%C(brightred)%d%C(reset) %C(brightyellow)%s%C(reset)'

