# Global-scope git config file, usually locates at ~/.gitconfig.
# Can be edited by: git config --edit --global

# some of configs are from: https://blog.gitbutler.com/how-git-core-devs-configure-git/

[init]
	# becoming the default in Git 3.0
	# https://git-scm.com/docs/BreakingChanges#_git_3_0
	defaultBranch = main

[core]
	longpaths = true
	autocrlf = true
	ignorecase = false
	symlinks = true
	editor = code --wait
	# https://stackoverflow.com/questions/34549040/git-not-displaying-unicode-file-names
	quotePath = false
	# https://superuser.com/questions/974078/what-does-the-filesystem-cache-do-in-windows-7
	fscache = true

[credential]
	# used to store multiple tokens
	# https://git-scm.com/docs/gitcredentials#Documentation/gitcredentials.txt-useHttpPath
	useHttpPath = true
	# TODO: This is from Git for Windows system config.
	#       What are possible values?
	#       Does this work also for MSYS2?
	#helper = manager
	# for MSYS2, requires package git-credential-wincred (of proper environment like UCRT64)
	helper = wincred

[commit]
	verbose = true

[tag]
	sort = version:refname

[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
	renames = true

[merge]
	ff = false
	# 'zdiff3' since Git 2.35.0; 'diff3' for earlier versions
	conflictStyle = zdiff3

[rebase]
	autoSquash = true
	# https://git-scm.com/docs/git-rebase#Documentation/git-rebase.txt-rebaserebaseMerges
	# https://stackoverflow.com/questions/56529435/what-is-the-behavior-of-the-cousins-options-in-git-rebase-rebase-merges
	rebaseMerges = no-rebase-cousins

[fetch]
	# fetch from *all* remotes
	all = true
	# prune = true
	# pruneTags = true

[pull]
	rebase = true

[help]
	autocorrect = prompt

[alias]
	aliases = config --get-regexp ^alias\\.

	confige = config --edit
	configs = config --list

	s = status

	# https://stackoverflow.com/a/35075021
	# adog = log --all --decorate --oneline --graph
	l = log --decorate=short --graph --abbrev=8 --pretty=tformat:'\t''%C(yellow)%h%C(reset) %C(green)%ci%C(reset) %C(ul)%an%C(reset)%C(brightred)%d%C(reset) %C(brightyellow)%s%C(reset)'
	la = l --all

	shown = show --name-only

	tags = tag --list

	b = branch

	sw = switch

	commit-init = commit --allow-empty --message 'Initial commit'
	commita = commit --amend --allow-empty
	commitan = commit --amend --no-edit
	commitf = commit --fixup
	ca = commita
	cf = commitf

	stashu = stash --include-untracked

	rebases = rebase --autostash
	rebasei = rebases --interactive

	f = fetch

